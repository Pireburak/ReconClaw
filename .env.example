# ReconClaw ayarları — bu dosyayı ".env" adıyla kopyalayıp doldurun:  cp .env.example .env
# .env dosyası gizli anahtarlar içerir, ASLA GitHub'a yüklemeyin (.gitignore'da zaten var).

# ---------------------------------------------------------------- genel
# Sitenin dışarıdan erişilen adresi. Alan adı aldığınızda doldurun (sonunda / olmadan).
PUBLIC_URL=
# PUBLIC_URL=https://reconclaw.com.tr

# Docker/Caddy kullanımında alan adınız (Caddy bununla otomatik HTTPS sertifikası alır)
DOMAIN=localhost
# DOMAIN=reconclaw.com.tr

HOST=127.0.0.1
PORT=8000

# Oturum çerezi yalnızca HTTPS ile gönderilsin (PUBLIC_URL https ise otomatik açılır)
# COOKIE_SECURE=true
SESSION_DAYS=7

# Yeni kayıtlara izin ver. İnternette yayındaysanız kendi hesabınızı açtıktan sonra false yapın.
ALLOW_SIGNUP=true

# 127.0.0.1 / 192.168.x.x gibi iç ağ adreslerinin taranması. Sunucu internete açıksa false yapın!
ALLOW_PRIVATE_TARGETS=true

# Dakikalık tarama sınırı abonelik planından gelir (Free 2, Pro 5, Pro Max 10, Ultra 20, Ultra Max 60).
# Burada verilen değer tüm planlar için ek bir üst sınırdır (0 = kapalı).
SCAN_RATE_LIMIT=0

# Yalnızca sahipliği kanıtlanmış hedeflerin (DNS TXT veya doğrulama dosyası) taranmasına izin ver.
# Herkesin kayıt olabildiği, internete açık bir sunucuda MUTLAKA true yapın.
REQUIRE_TARGET_VERIFICATION=false

# ---------------------------------------------------------------- v7.0 sürekli izleme

# Sürekli izleme görevlerini çalıştıran arka plan zamanlayıcısı (30 sn'de bir zamanı gelen görevlere bakar)
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- v8.2 bot koruması (Cloudflare Turnstile)
# Ücretsiz anahtar: https://dash.cloudflare.com → Turnstile → Add widget (alan adınızı ekleyin).
# İkisi de doluysa giriş ve kayıt formunda "robot değilim" doğrulaması çıkar ve sunucu tarafında kontrol edilir.
# Boşsa yalnızca bal küpü (gizli alan) ve hız sınırı çalışır.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- v8.1 bölgesel fiyatlandırma
# Türkiye'den gelenler TL, yurt dışındaki tüm ziyaretçiler Euro (€) öder.
# Yurt dışında her ücretli planın aylık fiyatına bu kadar TL eklenip güncel Euro kuruyla çevrilir; en ucuz fiyat hep Türkiye'dedir.
REGIONAL_SURCHARGE_TRY=950
# Ülke bulunamazsa / yerel ağdan bağlanılırsa kullanılacak ülke
DEFAULT_COUNTRY=TR
# Ziyaretçi IP'sinin ülkesini ipapi.co ile bul (önbellekli)
GEO_LOOKUP=true
# Cloudflare arkasındaysanız true yapın (CF-IPCountry başlığı kullanılır)
TRUST_COUNTRY_HEADER=false
# Cloudflare arkasındaysanız true yapın: ziyaretçinin gerçek IP'si CF-Connecting-IP başlığından alınır
# (ödeme, hız sınırı ve denetim kaydı için). Varsayılan TRUST_COUNTRY_HEADER ile aynıdır.
# Açıksa sunucunuzu yalnızca Cloudflare IP'lerine açın; aksi halde başlık sahtelenebilir.
# TRUST_PROXY_IP=false
# Euro kurunu elle sabitlemek için (1 € = kaç TL). Boşsa open.er-api.com'dan 12 saatte bir güncellenir.
# FX_RATES=EUR=52

# ---------------------------------------------------------------- v8.0 AI Analist
# Claude API anahtarı (https://console.anthropic.com). Boş bırakılırsa kural tabanlı çevrimdışı analist çalışır.
ANTHROPIC_API_KEY=
# Kullanılacak Claude modeli
AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- sosyal giriş
# Her sağlayıcıda yönlendirme (callback) adresi:  {PUBLIC_URL}/auth/<sağlayıcı>/callback
# Boş bırakılan sağlayıcının butonu giriş ekranında pasif görünür.

# Google — https://console.cloud.google.com/apis/credentials  (OAuth client ID > Web application)
#   Callback: https://reconclaw.alanadiniz.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers  (New OAuth App)
#   Callback: https://reconclaw.alanadiniz.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft — https://entra.microsoft.com  (App registrations > New registration, Web platformu)
#   Callback: https://reconclaw.alanadiniz.com/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources  (ücretli Apple Developer hesabı gerekir)
#   Services ID oluşturun (APPLE_CLIENT_ID), "Sign in with Apple" anahtarı (.p8) indirin.
#   Return URL: https://reconclaw.alanadiniz.com/auth/apple/callback  (Apple localhost kabul etmez, HTTPS şart)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# veya anahtarın kendisi (satır sonları \n olarak):
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---------------------------------------------------------------- v9.0 ödeme (PayTR)
# PayTR Mağaza Paneli → Destek & Kurulum → Entegrasyon Bilgileri. Üçü de doluysa demo ödeme kapanır, gerçek ödeme açılır.
# Panelde "Bildirim URL" olarak şunu girin:  {PUBLIC_URL}/odeme/paytr/bildirim
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Mağaza canlıya alınana kadar true kalsın (test kartlarıyla denenir, para çekilmez). Canlıya geçince false yapın.
PAYTR_TEST_MODE=true
# PayTR adres/telefon alanlarını zorunlu tutar; kullanıcıdan istenmediği için bunlar gönderilir (boşsa COMPANY_* kullanılır)
# PAYTR_DEFAULT_ADDRESS=
# PAYTR_DEFAULT_PHONE=

# ---------------------------------------------------------------- v9.0 satıcı bilgileri (yasal sayfalar)
# Mesafeli Satış Sözleşmesi, Ön Bilgilendirme, İade, KVKK ve İletişim sayfaları bu bilgilerle dolar.
# Sanal POS başvurusunda bu sayfaların eksiksiz yayında olması istenir. Vergi levhanızdaki bilgileri girin.
COMPANY_NAME=ReconClaw
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NO=
# Limited / anonim şirketler için (şahıs şirketinde boş bırakın)
COMPANY_MERSIS=
COMPANY_KEP=

# ---------------------------------------------------------------- v9.0 e-posta (şifremi unuttum)
# Boşsa "Şifremi unuttum" bağlantısı görünmez. 587 = STARTTLS, 465 = SSL.
# Örnek (Yandex): SMTP_HOST=smtp.yandex.com.tr  SMTP_PORT=465
# Örnek (Google Workspace / Gmail uygulama şifresi): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gönderen adresi (boşsa SMTP_USER), ör. no-reply@reconclaw.com.tr
SMTP_FROM=
SMTP_TLS=true

# Doğrudan "python main.py" ile çalıştırırken X-Forwarded-For başlığına güvenilecek vekil sunucular
# (yalnızca önünüzdeki Caddy / Nginx). Docker kurulumunda gerekmez.
FORWARDED_ALLOW_IPS=127.0.0.1
