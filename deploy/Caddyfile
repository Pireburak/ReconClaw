# Sertifika Cloudflare'den gelir. Caddy Let's Encrypt çağırmaz.
# Origin sertifikası: deploy/certs/origin.pem ve origin.key
{
	auto_https off
}

http://{$DOMAIN}, http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

https://{$DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip
	reverse_proxy reconclaw:8000
}

# www.alanadi → alanadi (tek kanonik adres; OAuth ve PayTR dönüş adresleri bununla eşleşmeli)
https://www.{$DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	redir https://{$DOMAIN}{uri} permanent
}
